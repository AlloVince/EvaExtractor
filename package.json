{
  "name": "evaextractor",
  "version": "0.0.0-development",
  "description": "A toolset for store/extract/transfer/iterator data in local disk/Ali cloud oss/AWS S3/minio",
  "main": "index.js",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "test": "ava --verbose --serial",
    "lint": "tsc --noEmit",
    "watch": "tsc -w",
    "build": "rm -rf lib && tsc"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [],
  "license": "MIT",
  "author": "",
  "homepage": "",
  "engines": {
    "node": ">=24.0.0"
  },
  "ava": {
    "files": [
      "test/**/*.ts"
    ],
    "sources": [
      "src/**/*.ts"
    ],
    "failFast": false,
    "tap": false,
    "require": [
      "ts-node/register"
    ],
    "extensions": [
      "ts"
    ],
    "babel": false
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "fast-glob": "^3.3.3"
  },
  "peerDependencies": {
    "ali-oss": "^6.23.0",
    "minio": "^8.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "ava": "^8.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
